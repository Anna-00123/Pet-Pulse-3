<Window x:Class="PetPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PetPulse"
        Title="{DynamicResource T_app_title}" Height="680" Width="1000"
        Background="{DynamicResource BgDarkBrush}" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="Black" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="Black" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1B8A6B" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style x:Key="HamburgerButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{DynamicResource T_menu_tooltip}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Rectangle Width="22" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="0,2" Fill="{DynamicResource TextPrimaryBrush}"/>
                                <Rectangle Width="22" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="0,2" Fill="{DynamicResource TextPrimaryBrush}"/>
                                <Rectangle Width="22" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="0,2" Fill="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ChipBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuItemButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="14,11">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ChipBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="15">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,10,0,25" HorizontalAlignment="Center">
                    <Viewbox Height="35" Width="35" Margin="0,0,10,0">
                        <Canvas Width="100" Height="100">
                            <Ellipse Canvas.Left="25" Canvas.Top="45" Width="50" Height="40" Fill="{DynamicResource AccentMintBrush}"/>
                            <Ellipse Canvas.Left="15" Canvas.Top="25" Width="18" Height="22" Fill="{DynamicResource AccentMintBrush}"/>
                            <Ellipse Canvas.Left="34" Canvas.Top="12" Width="18" Height="22" Fill="{DynamicResource AccentMintBrush}"/>
                            <Ellipse Canvas.Left="53" Canvas.Top="12" Width="18" Height="22" Fill="{DynamicResource AccentMintBrush}"/>
                            <Ellipse Canvas.Left="72" Canvas.Top="25" Width="18" Height="22" Fill="{DynamicResource AccentMintBrush}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="PetPulse" Foreground="{DynamicResource AccentMintBrush}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Background="{DynamicResource LineStrongBrush}" Margin="0,10"/>
                    <Button x:Name="NavAbout" Content="{DynamicResource T_nav_about}" Height="38" Margin="0,0,0,8" Foreground="Black" FontWeight="SemiBold" Click="NavButton_Click" Tag="About"/>
                    <Button Content="{DynamicResource T_exit}" Height="38" Background="{DynamicResource DangerBrush}" Foreground="White" FontWeight="Bold" Click="ExitButton_Click"/>
                    <TextBlock Text="v1.3.0 · ХАІ 2026" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="NavMeds" Content="{DynamicResource T_nav_meds}" Height="40" Margin="0,0,0,8" Foreground="Black" FontWeight="SemiBold" Click="NavButton_Click" Tag="Meds"/>
                    <Button x:Name="NavDocs" Content="{DynamicResource T_nav_docs}" Height="40" Margin="0,0,0,8" Foreground="Black" FontWeight="SemiBold" Click="NavButton_Click" Tag="Docs"/>
                    <Button x:Name="NavReminders" Content="{DynamicResource T_nav_reminders}" Height="40" Margin="0,0,0,8" Foreground="Black" FontWeight="SemiBold" Click="NavButton_Click" Tag="Reminders"/>
                    <Button x:Name="NavHealth" Content="{DynamicResource T_nav_health}" Height="40" Margin="0,0,0,8" Foreground="Black" FontWeight="SemiBold" Click="NavButton_Click" Tag="Health"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="25">

            <Grid x:Name="PanelMeds" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource T_meds_title}" Foreground="{DynamicResource AccentMintBrush}" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

                <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtMedName" Grid.Column="0" Height="35" Margin="0,0,8,0" Padding="8,5"
                                 Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Text=""
                                 GotFocus="TxtMedName_GotFocus" LostFocus="TxtMedName_LostFocus"/>

                        <TextBox x:Name="TxtMedDose" Grid.Column="1" Height="35" Margin="0,0,8,0" Padding="8,5"
                                 Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Text=""/>

                        <ComboBox x:Name="CmbMedDay" Grid.Column="2" Height="35" Margin="0,0,8,0" SelectedIndex="0" Foreground="Black">
                            <ComboBoxItem Content="{DynamicResource T_today}" Tag="today"/>
                            <ComboBoxItem Content="{DynamicResource T_tomorrow}" Tag="tomorrow"/>
                        </ComboBox>

                        <Button Grid.Column="3" Content="{DynamicResource T_add_btn}" Height="35" Background="{DynamicResource AccentEmeraldBrush}" Foreground="White" FontWeight="Bold" Click="AddMed_Click"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="LstMedicines" Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource InnerBgBrush}" CornerRadius="6" Padding="12" Margin="0,4" Width="680">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource AccentMintBrush}" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Dosage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="15,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ScheduleDay}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <local:EmptyStateView x:Name="EmptyMeds" Grid.Row="0" Visibility="Collapsed"/>

                    <Button Grid.Row="1" Content="{DynamicResource T_delete_sel}" Height="35" Width="160" HorizontalAlignment="Right" Margin="0,10,0,0" Background="{DynamicResource DangerBrush}" Foreground="White" FontWeight="Bold" Click="DeleteMed_Click"/>
                </Grid>
            </Grid>
            <Grid x:Name="PanelHealth" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{DynamicResource T_health_title}" Foreground="{DynamicResource AccentMintBrush}" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource T_pet_category}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,15,0"/>

                            <ComboBox x:Name="CmbDogBreedSize" Grid.Column="1" Height="35" SelectedIndex="0" Foreground="Black"
                                      SelectionChanged="CmbDogBreedSize_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource T_breed_small}"/>
                                <ComboBoxItem Content="{DynamicResource T_breed_mid}"/>
                                <ComboBoxItem Content="{DynamicResource T_breed_large}"/>
                            </ComboBox>

                            <Button Grid.Column="2" Content="{DynamicResource T_reset}" Height="35" Width="110" Margin="15,0,0,0"
                                    Background="{DynamicResource ChipBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource AccentEmeraldBrush}" FontWeight="Bold"
                                    Click="ResetHealthDefaults_Click"/>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="3" Height="165" Margin="0,0,0,20">
                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="12" Margin="5" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="LblPulseStatus" Grid.Row="0" Text="" Foreground="{DynamicResource AccentMintBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,10,0,0">
                                    <TextBox x:Name="TxtPulse" Text="100" FontSize="26" FontWeight="Bold"
                                             Foreground="{DynamicResource AccentMintBrush}" Background="Transparent"
                                             BorderThickness="0,0,0,2" BorderBrush="{DynamicResource LineStrongBrush}" Width="65"
                                             TextChanged="TxtPulse_TextChanged"/>
                                    <TextBlock Text="{DynamicResource T_bpm}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" VerticalAlignment="Bottom" Margin="5,0,0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="12" Margin="5" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="LblWeightStatus" Grid.Row="0" Text="" Foreground="{DynamicResource AccentMintBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,10,0,0">
                                    <TextBox x:Name="TxtWeight" Text="3.5" FontSize="26" FontWeight="Bold"
                                             Foreground="{DynamicResource AccentMintBrush}" Background="Transparent"
                                             BorderThickness="0,0,0,2" BorderBrush="{DynamicResource LineStrongBrush}" Width="65"
                                             TextChanged="TxtWeight_TextChanged"/>
                                    <TextBlock Text="{DynamicResource T_kg}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" VerticalAlignment="Bottom" Margin="5,0,0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="12" Margin="5" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="LblTempStatus" Grid.Row="0" Text="" Foreground="{DynamicResource AccentMintBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,10,0,0">
                                    <TextBox x:Name="TxtTemp" Text="38.5" FontSize="26" FontWeight="Bold"
                                             Foreground="{DynamicResource AccentMintBrush}" Background="Transparent"
                                             BorderThickness="0,0,0,2" BorderBrush="{DynamicResource LineStrongBrush}" Width="65"
                                             TextChanged="TxtTemp_TextChanged"/>
                                    <TextBlock Text=" °C" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" VerticalAlignment="Bottom" Margin="5,0,0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="15">
                        <TextBlock Text="{DynamicResource T_health_tip}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelReminders" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource T_rem_title}" Foreground="{DynamicResource AccentMintBrush}" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

                <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtCustomReminder" Grid.Column="0" Height="35" Margin="0,0,10,0" Padding="8,5"
                                 Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Text=""
                                 GotFocus="TxtCustomReminder_GotFocus" LostFocus="TxtCustomReminder_LostFocus"/>

                        <ComboBox x:Name="CmbReminderDay" Grid.Column="1" Height="35" Margin="0,0,10,0" SelectedIndex="0" Foreground="Black">
                            <ComboBoxItem Content="{DynamicResource T_today}" Tag="today"/>
                            <ComboBoxItem Content="{DynamicResource T_tomorrow}" Tag="tomorrow"/>
                        </ComboBox>

                        <Button Grid.Column="2" Content="{DynamicResource T_add_rem}" Height="35" Background="{DynamicResource AccentEmeraldBrush}" Foreground="White" FontWeight="Bold" Click="AddCustomReminder_Click"/>
                    </Grid>
                </Border>

                <ListBox x:Name="LstReminders" Grid.Row="2" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="15" Margin="0,4" Width="680">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{Binding TextColorBrush}"/>
                                        <TextBlock Text="{Binding ScheduleText}" FontSize="12" Foreground="{Binding SubTextColorBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="{DynamicResource AccentEmeraldBrush}" CornerRadius="5" Padding="8,4" Margin="10,0" Visibility="{Binding BadgeVisibility}" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource T_today_badge}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>

                                    <ToggleButton Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Width="90" Height="32" Click="ToggleReminder_Click">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="border" CornerRadius="16" Background="{DynamicResource ToggleOffBrush}">
                                                    <Grid>
                                                        <Ellipse x:Name="dot" Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="4,0"/>
                                                        <TextBlock x:Name="txt" Text="{DynamicResource T_toggle_off}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentEmeraldBrush}"/>
                                                        <Setter TargetName="dot" Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter TargetName="txt" Property="Text" Value="{DynamicResource T_toggle_on}"/>
                                                        <Setter TargetName="txt" Property="HorizontalAlignment" Value="Left"/>
                                                        <Setter TargetName="txt" Property="Margin" Value="8,0,0,0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <local:EmptyStateView x:Name="EmptyReminders" Grid.Row="2" Visibility="Collapsed"/>

                <Button Grid.Row="3" Content="{DynamicResource T_delete_sel}" Height="35" Width="160" HorizontalAlignment="Right" Margin="0,10,0,0" Background="{DynamicResource DangerBrush}" Foreground="White" FontWeight="Bold" Click="DeleteReminder_Click"/>
            </Grid>
            <Grid x:Name="PanelDocs" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource T_docs_title}" Foreground="{DynamicResource AccentMintBrush}" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

                <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Margin="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource T_doc_passport}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="№ UA-84920482" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,15"/>
                            <Border Background="{DynamicResource InnerBgBrush}" Height="90" CornerRadius="6" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource T_doc_scan}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBox x:Name="TxtDocChip" Text="" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Padding="5"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Margin="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource T_doc_vaccine}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource T_doc_vaccine_name}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,15"/>
                            <Border Background="{DynamicResource InnerBgBrush}" Height="90" CornerRadius="6" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource T_doc_photo}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBox x:Name="TxtDocValid" Text="" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Padding="5"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <Grid x:Name="PanelAbout" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{DynamicResource T_about_title}" Foreground="{DynamicResource AccentMintBrush}" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource T_about_text}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,20"/>
                            <TextBlock Text="{DynamicResource T_about_version}" Foreground="{DynamicResource AccentMintBrush}" FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Button x:Name="BtnMenu" Style="{StaticResource HamburgerButton}" Width="42" Height="38"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10" Click="BtnMenu_Click"/>

            <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=BtnMenu}" Placement="Bottom" HorizontalOffset="-226"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="6" Margin="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel Width="252">
                        <Button Style="{StaticResource MenuItemButton}" Content="{DynamicResource T_menu_settings}" Click="MenuSettings_Click"/>
                        <Button Style="{StaticResource MenuItemButton}" Content="{DynamicResource T_menu_vet}" Click="MenuVet_Click"/>
                        <Separator Background="{DynamicResource LineBrush}" Margin="6,4"/>
                        <Button x:Name="BtnQuickTheme" Style="{StaticResource MenuItemButton}" Click="MenuTheme_Click"/>
                    </StackPanel>
                </Border>
            </Popup>

        </Grid>
    </Grid>
</Window>