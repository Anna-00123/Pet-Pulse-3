<UserControl x:Class="PetPulse.EmptyStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="380">
        <Grid Width="84" Height="84" HorizontalAlignment="Center">
            <Ellipse Fill="{DynamicResource ChipBgBrush}"/>
            <TextBlock Text="{Binding Icon, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="34"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Margin="0,16,0,0" Foreground="{DynamicResource AccentMintBrush}"/>
        <TextBlock Text="{Binding Hint, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="13"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <Button x:Name="ActionButton" Content="{Binding ActionText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,18,0,0"
                Padding="20,9" Cursor="Hand" Foreground="White" FontWeight="Bold"
                Background="{DynamicResource AccentEmeraldBrush}" Click="ActionButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </StackPanel>
</UserControl>