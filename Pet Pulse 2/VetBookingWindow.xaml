<Window x:Class="PetPulse.VetBookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource T_vet_window}" Width="880" Height="690"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize"
        Background="{DynamicResource BgDarkBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="Black" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="Black" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1B8A6B" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputFgBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource InputFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentEmeraldBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource ChipBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="ClinicContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentMintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentEmeraldBrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="SlotTemplate" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="SlotFree" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InnerBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource SlotTemplate}"/>
        </Style>
        <Style x:Key="SlotSelected" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentEmeraldBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentEmeraldBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource SlotTemplate}"/>
        </Style>
        <Style x:Key="SlotBusy" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
            <Setter Property="Cursor" Value="No"/>
            <Setter Property="Template" Value="{StaticResource SlotTemplate}"/>
        </Style>

        <Style x:Key="SpeciesChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{DynamicResource InnerBgBrush}" BorderBrush="{DynamicResource LineStrongBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="22,10" Margin="0,0,10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentMintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentEmeraldBrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ChipBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource T_vet_title}" Foreground="{DynamicResource AccentMintBrush}" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="LblStep" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid x:Name="PanelClinics" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{DynamicResource T_clinics_hint}"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,10"/>
            <ListBox x:Name="LstClinics" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ClinicContainer}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="LstClinics_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AccentMintBrush}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Address}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding RatingText}" Foreground="{DynamicResource WarnBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="2" Text="{DynamicResource T_demo_note}"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,8,0,0"/>
        </Grid>

        <Grid x:Name="PanelDateTime" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock x:Name="LblClinicName" Foreground="{DynamicResource AccentMintBrush}" FontSize="17" FontWeight="Bold"/>
                    <TextBlock x:Name="LblClinicInfo" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1">
                <TextBlock Text="{DynamicResource T_date_label}" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbDate" Width="280" Height="36" HorizontalAlignment="Left" SelectionChanged="CmbDate_SelectionChanged"/>
                <TextBlock Text="{DynamicResource T_time_label}" Style="{StaticResource FieldLabel}" Margin="0,18,0,8"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <WrapPanel x:Name="SlotsPanel"/>
                    <TextBlock x:Name="LblSlotInfo" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="{DynamicResource T_slot_legend}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="PanelPet" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource T_f_pet}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtPetName" MaxLength="40"/>

                <TextBlock Text="{DynamicResource T_f_species}" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbCat" GroupName="Species" Style="{StaticResource SpeciesChoice}" Content="{DynamicResource T_cat}"/>
                    <RadioButton x:Name="RbDog" GroupName="Species" Style="{StaticResource SpeciesChoice}" Content="{DynamicResource T_dog}"/>
                </StackPanel>

                <TextBlock Text="{DynamicResource T_f_owner}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtOwner" MaxLength="60"/>

                <TextBlock Text="{DynamicResource T_f_phone}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtPhone" MaxLength="20" PreviewTextInput="TxtPhone_PreviewTextInput" ToolTip="+380 50 123 45 67"/>
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource T_f_complaint}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtComplaint" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" MaxLength="1000"/>
                <TextBlock x:Name="LblError" Grid.Row="2" Foreground="{DynamicResource AlertBrush}" FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
        </Grid>

        <Border x:Name="PanelDone" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource CardBgBrush}"
                CornerRadius="12" Padding="24" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{DynamicResource T_booked_title}" Foreground="{DynamicResource AccentMintBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,14"/>
                <TextBlock x:Name="LblDone" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap" LineHeight="26"/>
                <TextBlock Text="{DynamicResource T_booked_note}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="BtnBack" Style="{StaticResource GhostButton}" Content="{DynamicResource T_back}" HorizontalAlignment="Left" Click="BtnBack_Click"/>
            <Button x:Name="BtnNext" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="BtnNext_Click"/>
        </Grid>
    </Grid>
</Window>