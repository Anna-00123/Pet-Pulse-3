<Window x:Class="PetPulse.RemarkDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource T_cat_remarks}" Width="620" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize"
        Background="{DynamicResource BgDarkBrush}">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="LblTitle" Foreground="{DynamicResource AccentMintBrush}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" Margin="0,10,0,14">
            <TextBlock x:Name="LblStatus" FontSize="14" FontWeight="Bold"/>
            <TextBlock x:Name="LblMeta" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LblDetails" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap" LineHeight="24"/>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="3" Content="{DynamicResource T_close}" Height="40" Width="140" HorizontalAlignment="Right" Margin="0,14,0,0"
                Background="{DynamicResource AccentEmeraldBrush}" Foreground="White" FontWeight="Bold" Click="Close_Click"/>
    </Grid>
</Window>