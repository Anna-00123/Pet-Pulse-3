<Window x:Class="PetPulse.AddRemarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource T_rem_add_title}" Width="580" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize"
        Background="{DynamicResource BgDarkBrush}">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputFgBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource InputFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource T_rem_add_title}" Foreground="{DynamicResource AccentMintBrush}" FontSize="24" FontWeight="Bold"/>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{DynamicResource T_rem_field_title}" Style="{StaticResource FieldLabel}"/>
            <TextBox Grid.Row="1" x:Name="TxtTitle" MaxLength="80"/>
            <TextBlock Grid.Row="2" Text="{DynamicResource T_rem_field_author}" Style="{StaticResource FieldLabel}"/>
            <TextBox Grid.Row="3" x:Name="TxtAuthor" MaxLength="60"/>
            <TextBlock Grid.Row="4" Text="{DynamicResource T_rem_field_details}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top"/>
            <TextBox Grid.Row="4" x:Name="TxtDetails" Margin="0,38,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" MaxLength="1500"/>
            <TextBlock Grid.Row="5" x:Name="LblError" Foreground="{DynamicResource AlertBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource T_rem_cancel}" Height="40" MinWidth="120" Margin="0,0,10,0" Background="{DynamicResource ChipBgBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource AccentEmeraldBrush}" FontWeight="Bold" Click="Cancel_Click"/>
            <Button Content="{DynamicResource T_rem_save}" Height="40" MinWidth="140" Background="{DynamicResource AccentEmeraldBrush}"
                    Foreground="White" FontWeight="Bold" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>