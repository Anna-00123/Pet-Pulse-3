<Window x:Class="PetPulse.RemarksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource T_rem_list_title}" Width="780" Height="660"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize"
        Background="{DynamicResource BgDarkBrush}">

    <Window.Resources>
        <Style x:Key="RemarkContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Margin="0,0,10,8"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource T_rem_list_title}" Foreground="{DynamicResource AccentMintBrush}" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="LblCounts" Foreground="{DynamicResource AccentMintBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <TextBlock Text="{DynamicResource T_rem_open_hint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <ListBox x:Name="LstRemarks" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource RemarkContainer}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Card" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14,12" Cursor="Hand" MouseLeftButtonUp="Card_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding Done, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0"
                                      Click="Done_Click" Cursor="Arrow"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="TitleText" Text="{Binding Title}" Foreground="{DynamicResource AccentMintBrush}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SummaryText" Text="{Binding Summary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="14,0,0,0" HorizontalAlignment="Right">
                                <TextBlock x:Name="DateText" Text="{Binding CreatedText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="StatusText" Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Done}" Value="True">
                            <Setter TargetName="Card" Property="Opacity" Value="0.55"/>
                            <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                            <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough"/>
                            <Setter TargetName="SummaryText" Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2" Content="{DynamicResource T_close}" Height="40" Width="140" HorizontalAlignment="Right" Margin="0,12,0,0"
                Background="{DynamicResource AccentEmeraldBrush}" Foreground="White" FontWeight="Bold" Click="Close_Click"/>
    </Grid>
</Window>