<Window x:Class="PetPulse.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource T_set_window}" Width="800" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize"
        Background="{DynamicResource BgDarkBrush}">

    <Window.Resources>
        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" CornerRadius="16" Background="{DynamicResource ToggleOffBrush}">
                            <Grid>
                                <Ellipse x:Name="dot" Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="4,0"/>
                                <TextBlock x:Name="txt" Text="{DynamicResource T_toggle_off}" Foreground="White" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentEmeraldBrush}"/>
                                <Setter TargetName="dot" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="txt" Property="Text" Value="{DynamicResource T_toggle_on}"/>
                                <Setter TargetName="txt" Property="HorizontalAlignment" Value="Left"/>
                                <Setter TargetName="txt" Property="Margin" Value="8,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{DynamicResource InnerBgBrush}"
                                BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16,13" Margin="0,0,0,10">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentMintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentEmeraldBrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ChipBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LangItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentMintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentEmeraldBrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ChipBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="15">
                <TextBlock Text="{DynamicResource T_menu_settings}" Foreground="{DynamicResource AccentMintBrush}" FontSize="20" FontWeight="Bold" Margin="0,10,0,22"/>
                <RadioButton GroupName="Cat" Style="{StaticResource CategoryItem}" Content="{DynamicResource T_cat_graphics}" Tag="Graphics" Checked="Category_Checked"/>
                <RadioButton GroupName="Cat" Style="{StaticResource CategoryItem}" Content="{DynamicResource T_cat_language}" Tag="Language" Checked="Category_Checked"/>
                <RadioButton GroupName="Cat" Style="{StaticResource CategoryItem}" Content="{DynamicResource T_cat_notify}" Tag="Notify" Checked="Category_Checked"/>
                <RadioButton x:Name="RbRemarks" GroupName="Cat" Style="{StaticResource CategoryItem}" Content="{DynamicResource T_cat_remarks}" Tag="Remarks" Checked="Category_Checked"/>
                <RadioButton GroupName="Cat" Style="{StaticResource CategoryItem}" Content="{DynamicResource T_cat_general}" Tag="General" Checked="Category_Checked"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource SettingsBgBrush}">
            <Grid Margin="30">

                <StackPanel x:Name="PawPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Viewbox Width="190" Height="190">
                        <Canvas Width="100" Height="100">
                            <Ellipse Canvas.Left="25" Canvas.Top="45" Width="50" Height="40" Fill="{DynamicResource PawBrush}"/>
                            <Ellipse Canvas.Left="15" Canvas.Top="25" Width="18" Height="22" Fill="{DynamicResource PawBrush}"/>
                            <Ellipse Canvas.Left="34" Canvas.Top="12" Width="18" Height="22" Fill="{DynamicResource PawBrush}"/>
                            <Ellipse Canvas.Left="53" Canvas.Top="12" Width="18" Height="22" Fill="{DynamicResource PawBrush}"/>
                            <Ellipse Canvas.Left="72" Canvas.Top="25" Width="18" Height="22" Fill="{DynamicResource PawBrush}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource T_pick_section}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>

                <StackPanel x:Name="PanelGraphics" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource T_cat_graphics}" Foreground="{DynamicResource AccentMintBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,18"/>
                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{DynamicResource T_light_theme}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{DynamicResource T_light_theme_desc}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="TglLight" Grid.Column="1" Style="{StaticResource SwitchToggle}" Click="TglLight_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PanelLanguage" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource T_cat_language}" Foreground="{DynamicResource AccentMintBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,18"/>
                    <TextBlock Text="{DynamicResource T_lang_title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{DynamicResource T_lang_desc}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,14"/>
                    <ListBox x:Name="LstLanguages" Background="Transparent" BorderThickness="0" Height="300"
                             ItemContainerStyle="{StaticResource LangItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="LstLanguages_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel x:Name="PanelNotify" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource T_cat_notify}" Foreground="{DynamicResource AccentMintBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,18"/>
                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{DynamicResource T_notify_set_title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{DynamicResource T_notify_set_desc}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="TglNotify" Grid.Column="1" Style="{StaticResource SwitchToggle}" Click="TglNotify_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PanelRemarks" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource T_cat_remarks}" Foreground="{DynamicResource AccentMintBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,18"/>
                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <TextBlock x:Name="LblRemarksText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                            <Button x:Name="BtnRemarkAction" Height="40" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="20,0"
                                    Background="{DynamicResource AccentEmeraldBrush}" Foreground="White" FontWeight="Bold" Click="BtnRemarkAction_Click"/>
                            <TextBlock x:Name="LblRemarksInfo" Foreground="{DynamicResource AccentMintBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PanelGeneral" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource T_cat_general}" Foreground="{DynamicResource AccentMintBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,18"/>
                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{DynamicResource T_confirm_exit_title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{DynamicResource T_confirm_exit_desc}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="TglConfirmExit" Grid.Column="1" Style="{StaticResource SwitchToggle}" Click="TglConfirmExit_Click"/>
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource T_role_title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="LblRoleCurrent" Foreground="{DynamicResource AccentMintBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock x:Name="LblRoleDesc" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <Button x:Name="BtnRole" Height="38" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="18,0"
                                    Background="{DynamicResource ChipBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                    BorderBrush="{DynamicResource AccentEmeraldBrush}" FontWeight="Bold" Click="BtnRole_Click"/>
                        </StackPanel>
                    </Border>
                    <Button Content="{DynamicResource T_reset_settings}" Height="38" HorizontalAlignment="Left" Padding="18,0"
                            Background="{DynamicResource ChipBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource AccentEmeraldBrush}" FontWeight="Bold" Click="ResetSettings_Click"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>